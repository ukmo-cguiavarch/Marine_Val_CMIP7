moo get --fill-gaps moo:/crum/${suiteId}/ony.nc.file/nemo_${suiteId#*-}o_1y_*grid*[U,V,T]*  ${RUNPATH}/.
moo get --fill-gaps moo:/crum/${suiteId}/ons.nc.file/nemo_${suiteId#*-}o_1s_????1201*grid*T*  ${RUNPATH}/.
moo get --fill-gaps moo:/crum/${suiteId}/onm.nc.file/nemo_${suiteId#*-}o_1m_????0301*grid*T*  ${RUNPATH}/.
moo get --fill-gaps moo:/crum/${suiteId}/onm.nc.file/nemo_${suiteId#*-}o_1m_????0901*grid*T*  ${RUNPATH}/.

module load scitools
ROOT=${RUNPATH}/nemo_${suiteId#*-}o_1*
for FILE in ${ROOT}*grid-T* ; do
#   ncatted -a standard_name,"deptht",c,c,"depth" $FILE;
   ncrename -v so,so_pra $FILE;
   ncrename -v thetao,thetao_pot $FILE;
   ncrename -v mlotst,somxzint1 $FILE
#   ncrename -v thkcello,cell_thickness $FILE;
#   ncrename -v masscello,e3t $FILE;
   echo $FILE;
done

